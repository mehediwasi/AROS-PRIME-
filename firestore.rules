rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'jiniajannatulfardaus435@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    match /licenses/{licenseId} {
      allow read: if true;
      allow write: if true;
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    match /devices/{deviceId} {
      allow read: if true;
      allow write: if true;
    }

    match /licenseIndex/{key} {
      allow read: if true;
      allow write: if true;
    }

    match /plans/{planId} {
      allow read: if true;
      allow write: if true;
    }

    match /usage/{licenseId} {
      allow read: if true;
      allow write: if true;

      match /history/{date} {
        allow read: if true;
        allow write: if true;
      }
    }

    match /signals/{signalId} {
      allow read: if true;
      allow write: if true;
    }

    match /adminLogs/{logId} {
      allow read: if true;
      allow write: if true;
    }

    match /admins/{adminId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
